{
  "appId": "com.wirodev.tirtamoico.logbook",
  "appName": "Logbook Portal",
  "webDir": "public",
  "server": {
    "url": "https://logbook.wirodev.com",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#002A58",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#002A58"
    }
  }
}
